{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    ".specify/memory/constitution.md",
    ".opencode/instructions/*.md"
  ],

  "lsp": true,

  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      ".idea/**",
      ".kotlin/**",
      ".specify/cache/**",
      "build/**",
      "**/build/**",
      "**/.build/**",
      "**/DerivedData/**"
    ]
  },

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },

    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",

    "edit": {
      "*": "ask",
      "webApp/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },

    "external_directory": "deny",

    "bash": {
      "*": "ask",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git branch --show-current *": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git config --get remote.origin.url": "allow",

      "./gradlew projects": "allow",
      "./gradlew projects *": "allow",
      "./gradlew tasks": "allow",
      "./gradlew tasks *": "allow",

      "git switch *": "ask",
      "git checkout -b *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git stash *": "ask",
      "git restore *": "ask",

      "git branch -d *": "ask",
      "git branch -D *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",

      "rm -rf *": "deny"
    }
  }
}